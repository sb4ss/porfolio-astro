<div class="terminal-scene">
<figure class="terminal" aria-label="Tukicode interface preview">
  <figcaption class="terminal-bar">
    <span class="window-controls" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="terminal-title">bash — tuki chat</span>
    <span class="preview-label">Preview</span>
  </figcaption>
  <div class="terminal-body">
    <div class="tuki-identity">
      <div class="tuki-info"><strong>TukiCode</strong><p>The AI coding agent in your terminal.</p><span class="model-hint">Local & cloud models</span></div>
    </div>
    <div class="command-guide" aria-label="Example commands"><code>/help</code><code>/clear</code><code>/plan</code></div>
    <div class="conversation">
      <p class="welcome">Welcome to TukiCode!</p>
      <p class="chat-line"><span class="speaker user">[You]</span><span>Explore this portfolio.</span></p>
      <p class="chat-line"><span class="speaker agent">[Tuki]</span><span>Web applications, automation, and open source. Built by Sebastián.</span></p>
      <p class="prompt-line" aria-hidden="true"><span>❯</span><span class="cursor"></span></p>
    </div>
  </div>
</figure>
</div>
<script>
  // Same viewport-based parallax as tukicode-website/src/pages/index.astro.
  const panel = document.querySelector<HTMLElement>('.terminal-scene .terminal');
  const desktop = matchMedia('(min-width: 1025px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  const follow = (event: MouseEvent) => {
    const x = event.clientX / window.innerWidth - .5;
    const y = event.clientY / window.innerHeight - .5;
    if (panel) panel.style.transform =
      `perspective(1000px) rotateX(${y * 10}deg) rotateY(${-5 + x * -10}deg) translateY(-5px)`;
  };
  function configure() {
    document.removeEventListener('mousemove', follow);
    if (desktop.matches) {
      if (panel) panel.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(-5deg) translateY(-5px)';
      document.addEventListener('mousemove', follow);
    } else {
      panel?.style.removeProperty('transform');
    }
  }
  configure();
  desktop.addEventListener('change', configure);
  document.addEventListener('astro:before-swap', () => {
    document.removeEventListener('mousemove', follow);
    desktop.removeEventListener('change', configure);
  }, { once: true });
</script>
<style>
  .terminal-scene { min-width: 0; width: 100%; perspective: 1000px; }
  .terminal { min-width: 0; width: 100%; margin: 0; overflow: hidden; border: 1px solid #ffffff24; border-radius: 12px; background: #141414; box-shadow: none; transform-origin: center; transition: transform .5s ease; font-family: Consolas, 'Cascadia Code', monospace; font-size: 12px; line-height: 1.75; color: #d0d3d0; }
  .terminal-bar { display: flex; align-items: center; gap: 14px; padding: 12px 18px; border-bottom: 1px solid #ffffff12; background: #141414; }
  .window-controls { display: flex; align-items: center; gap: 6px; }
  .window-controls span { width: 8px; height: 8px; border-radius: 50%; background: #e16b65; }
  .window-controls span:nth-child(2) { background: #d7b15d; }
  .window-controls span:nth-child(3) { background: #68b782; }
  .terminal-title { color: #b4bcb6; font-size: 11px; flex: 1; }
  .preview-label { font: 12px 'League Spartan', sans-serif; color: #9fa7a1; }
  .terminal-body { padding: 26px 24px 20px; }
  .tuki-identity { display: block; }
  .tuki-info { min-width: 0; }
  .tuki-info strong { color: #60c5df; font-size: 18px; }
  .tuki-info p { margin: 4px 0 10px; color: #b5bdb7; font-size: 12px; }
  .model-hint { color: #acc395; font-size: 11px; }
  .command-guide { display: flex; gap: 22px; margin-top: 26px; padding-bottom: 20px; border-bottom: 1px solid #ffffff12; color: #c7a8bb; font-size: 11px; }
  .welcome { color: #a7d84b; font-size: 12px; margin: 20px 0 16px; }
  .chat-line { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; font-size: 12px; }
  .speaker { flex-shrink: 0; }
  .user { color: #60c5df; }
  .agent { color: #a7d84b; }
  .prompt-line { display: flex; align-items: center; gap: 10px; margin-top: 18px; color: #a7d84b; }
  .cursor { width: 7px; height: 14px; background: #a7d84b; }
  @media (max-width: 1000px) and (min-width: 801px) { .terminal-body { padding: 22px 18px 18px; } }
  @media (max-width: 400px) { .terminal-body { padding: 20px 16px 16px; } .preview-label { display: none; } .chat-line, .tuki-info p { font-size: 11px; } }
  @media (prefers-reduced-motion: reduce) { .terminal { transition: none; transform: none; } }
</style>
