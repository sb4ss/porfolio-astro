---
import Python from './stack/Python.astro';
import Ollama from './stack/Ollama.astro';
import AI from './stack/AI.astro';
---
<article class="featured-tuki" aria-labelledby="featured-title">
  <header class="featured-heading">
    <div class="featured-brand"><img src="/tukicode/mascot.png" width="56" height="56" alt="" /><h2 id="featured-title">TukiCode</h2></div>
    <a class="featured-site" href="https://www.tukicode.site/es/"><span>Explore Tukicode</span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
  </header>
  <figure class="featured-demo">
    <video controls playsinline preload="metadata" aria-label="Tukicode demonstration">
      <source src="/tukicode/plan-mode.mp4" type="video/mp4" />
      <a href="/tukicode/plan-mode.mp4">Watch the demo</a>
    </video>
    <figcaption><span>Tukicode in action</span><span class="demo-detail">tuki chat / plan mode</span></figcaption>
  </figure>
  <div class="featured-details">
    <div class="featured-copy">
      <p class="featured-description">An open-source AI coding agent I build for the terminal. It explores projects, edits files, and runs commands with local or cloud models.</p>
      <div class="featured-tech"><Python /><AI /><Ollama /></div>
    </div>
    <div class="featured-repository">
      <a class="repository-name" href="https://github.com/tuki-labs/tukicode"><i class="fa-brands fa-github" aria-hidden="true"></i><span>tuki-labs/tukicode</span><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
      <dl class="repo-stats" aria-label="Repository statistics">
        <div><dt><i class="fa-regular fa-star" aria-hidden="true"></i><span>Stars</span></dt><dd data-repo-stat="stars">—</dd></div>
        <div><dt><i class="fa-solid fa-code-fork" aria-hidden="true"></i><span>Forks</span></dt><dd data-repo-stat="forks">—</dd></div>
        <div><dt><i class="fa-regular fa-circle-dot" aria-hidden="true"></i><span>Open issues</span></dt><dd data-repo-stat="issues">—</dd></div>
      </dl>
      <p class="repo-status" data-repo-status role="status">Loading GitHub statistics…</p>
    </div>
  </div>
</article>
<style>
  .featured-tuki { width: 100%; max-width: 1060px; margin-bottom: 80px; color: #e5e9e6; font-weight: 400; font-size: 16px; --ease-out: cubic-bezier(.23,1,.32,1); }
  .featured-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .featured-brand { display: flex; align-items: center; gap: 20px; min-width: 0; }
  .featured-brand img { width: 56px; height: 56px; object-fit: contain; image-rendering: pixelated; }
  h2 { font-size: clamp(42px, 6vw, 72px); font-weight: 650; letter-spacing: -.035em; line-height: 1; }
  .featured-site { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: #abffd1; font-size: 16px; text-underline-offset: 6px; }
  .featured-site i { font-size: 14px; transition: transform 200ms var(--ease-out); }
  a:focus-visible { outline: 2px solid #abffd1; outline-offset: 5px; }
  .featured-demo { min-width: 0; margin: 0; }
  video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #0c0e0c; border-radius: 12px; }
  figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; color: #aab8ae; font-size: 13px; }
  .demo-detail { font-family: Consolas, monospace; font-size: 12px; }
  .featured-details { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 72px; margin-top: 32px; }
  .featured-description { font-size: 19px; line-height: 1.5; color: #c4cec7; max-width: 48ch; }
  .featured-tech { display: flex; flex-wrap: wrap; margin: 20px -5px 0; }
  .featured-repository { min-width: 0; border-left: 1px solid #ffffff1a; padding-left: 32px; }
  .repository-name { display: inline-flex; align-items: center; gap: 10px; color: #e5e9e6; min-height: 44px; font-size: 15px; }
  .repository-name i:last-child { font-size: 11px; color: #aab8ae; margin-left: 8px; }
  .repo-stats { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 16px; }
  .repo-stats > div { display: flex; flex-direction: column-reverse; gap: 8px; }
  dt { display: flex; gap: 7px; align-items: center; color: #aab8ae; font-size: 13px; }
  dd { font-size: 25px; line-height: 1; font-variant-numeric: tabular-nums; font-weight: 500; color: #e5e9e6; }
  .repo-status { margin-top: 22px; color: #aab8ae; font-size: 12px; line-height: 1.5; }
  @media (hover: hover) and (pointer: fine) { .featured-site:hover { text-decoration: underline; } .featured-site:hover i { transform: translate(2px,-2px); } .repository-name:hover { color: #abffd1; } }
  .featured-site:active { opacity: .75; }
  @media (max-width: 700px) {
    .featured-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 20px; }
    .featured-brand { gap: 14px; }
    .featured-brand img { width: 42px; height: 42px; }
    .featured-details { grid-template-columns: minmax(0, 1fr); gap: 28px; margin-top: 24px; }
    .featured-repository { border-left: 0; border-top: 1px solid #ffffff1a; padding: 20px 0 0; }
    .featured-description { font-size: 18px; }
    .demo-detail { display: none; }
    .featured-tuki { margin-bottom: 64px; }
  }
  @media (prefers-reduced-motion: reduce) { .featured-site i { transition: none; } .featured-site:hover i { transform: none; } }
</style>
