---
import { getCollection } from "astro:content";
const projectsCard = (await getCollection("projects")).filter(card => card.slug !== 'tukicode');
const order = ['tukicode', 'fundesoemco', 'pynasa', 'taskflow', 'coffe', 'weaterapp'];
projectsCard.sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug));
import JS from "../components/stack/JS.astro";
import Node from "../components/stack/Node.astro";
import Css from "./stack/Css.astro";
import Html from "./stack/Html.astro";
import React from "./stack/React.astro";
import Ast from "./stack/Ast.astro";
import Mongo from "./stack/Mongo.astro";
import Python from "./stack/Python.astro";
import AI from "./stack/AI.astro";
import Ollama from "./stack/Ollama.astro";
import Vite from "./stack/Vite.astro";
import Tailwind from "./stack/Tailwind.astro";
import Supabase from "./stack/Supabase.astro";
const badges = { JavaScript: JS, Node, CSS: Css, HTML: Html, Ast, React, Mongo, Python, AI, Ollama, Vite, 'Tailwind CSS': Tailwind, Supabase };
---

<div class="project-carousel" role="region" aria-roledescription="carousel" aria-label="Projects">
  <div class="carousel-controls">
    <button type="button" data-carousel-prev aria-label="Previous projects"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
    <button type="button" data-carousel-next aria-label="Next projects"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
  </div>
<div class="carousel-viewport">
<div class="project-track">
  {
    projectsCard.map((card) => {
      const { data } = card;
      const { title, desc, descEs, img, tech, link, github, category, linkLabel } = data;

      return (
        <article class="card" aria-label={title}>
          <div class="project-media">
            {img ? <img src={img} alt={title} loading="lazy" /> : <div class="client-cover"><i class="fa-solid fa-qrcode" aria-hidden="true"></i><span>Fundesoemco</span><small>Employee attendance</small></div>}
          </div>
          <div class="title">
            <h2>{title}</h2>
            <div class="links">
              {github && <a href={`${github}`} aria-label={`GitHub: ${title}`}>
                <i class="fa-brands fa-github" />
              </a>}
              {link && <a href={`${link}`} aria-label={linkLabel || 'Project website'} title={linkLabel || 'Project website'}>
                <i class="fa-solid fa-link" />
              </a>}
            </div>
          </div>

          {category && <small class="category">{category}</small>}
          <p data-i18n-en={desc} data-i18n-es={descEs || desc}>{desc}</p>
          <div class="tech">
            {Object.values(tech).map((techName) => {
              const Badge = badges[techName];
              return Badge ? <Badge /> : null;
            })}
          </div>
        </article>
      );
    })
  }
</div>
</div>
</div>
<script>
  import { initializeCarousel } from './project-carousel.js';
  initializeCarousel();
</script>
<style>
  .project-carousel { width: 100%; max-width: 1060px; min-width: 0; --ease-out: cubic-bezier(.23,1,.32,1); }
  .carousel-controls { display: flex; justify-content: flex-end; gap: 8px; margin: -60px 0 28px; }
  .carousel-controls button { width: 44px; height: 44px; border: 1px solid #ffffff24; border-radius: 50%; background: transparent; color: #abffd1; font-size: 15px; cursor: pointer; transition: background-color 160ms ease, transform 160ms var(--ease-out); }
  .carousel-controls button:active { transform: scale(.96); }
  .carousel-controls button:focus-visible, .links a:focus-visible { outline: 2px solid #abffd1; outline-offset: 3px; }
  .carousel-viewport { overflow: hidden; width: 100%; touch-action: pan-y; }
  .project-track { display: flex; align-items: stretch; gap: 32px; width: 100%; }
  .card { position: relative; display: flex; flex-direction: column; flex: 0 0 calc((100% - 32px) / 2); min-width: 0; color: #b8c3bc; font-weight: 400; font-size: 15px; padding-bottom: 6px; }
  .project-media { width: 100%; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 12px; background: #292929; }
  .project-media img { width: 100%; height: 100%; object-fit: contain; transition: transform 250ms var(--ease-out); }
  .title { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 52px; margin: 20px 0 12px; }
  .title h2 { min-width: 0; font-size: clamp(23px, 2.4vw, 29px); font-weight: 500; letter-spacing: -.02em; color: #e5e9e6; overflow-wrap: anywhere; }
  .links { display: flex; flex-shrink: 0; }
  .links a { display: inline-flex; width: 44px; height: 44px; justify-content: center; align-items: center; font-size: 19px; transition: color 160ms ease; }
  .client-cover { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 8px; width: 100%; height: 100%; padding: 30px; background: #abffd1; color: #112d1c; }
  .client-cover i { font-size: 40px; margin-bottom: auto; }
  .client-cover span { font-size: clamp(26px, 3vw, 38px); font-weight: 600; letter-spacing: -.03em; line-height: 1.1; }
  .client-cover small { font-size: 16px; }
  .category { color: #abffd1; font-size: 13px; margin-bottom: 12px; }
  .card > p { line-height: 1.65; margin-bottom: 20px; max-width: 62ch; }
  .tech { display: flex; align-items: center; flex-wrap: wrap; margin: auto -5px 0; padding-top: 8px; }
  @media (hover: hover) and (pointer: fine) { .carousel-controls button:hover { background: #ffffff0c; } .card:hover .project-media img { transform: scale(1.025); } .links a:hover { color: #abffd1; } }
  @media (max-width: 700px) { .project-track { gap: 20px; } .card { flex-basis: 100%; } .title h2 { font-size: 24px; } .client-cover { padding: 24px; } .carousel-controls { margin-top: -58px; } }
  @media (max-width: 380px) { .carousel-controls { margin-top: 0; } }
  @media (prefers-reduced-motion: reduce) { .project-media img, .carousel-controls button { transition: none; } .card:hover .project-media img, .carousel-controls button:active { transform: none; } }
</style>
